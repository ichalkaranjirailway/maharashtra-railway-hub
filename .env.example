# ============================================================================
# ENVIRONMENT VARIABLES — copy to .env for local dev only.
# NEVER commit a real .env file. NEVER put SECRET values in frontend code
# or in any file that ships to GitHub Pages — that folder is fully public.
# ============================================================================

# ---- PUBLIC (safe to expose in frontend JS, once Phase 2 is wired up) -----
# Anonymous, read-only key — Supabase enforces via Row Level Security (see
# database/rls_policies.sql) that this key cannot write and cannot read
# unverified content. Safe to embed in assets/app.js.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---- SECRET (server-side / GitHub Actions Secrets ONLY — never in the repo,
# never in frontend code, never in this file with a real value) ------------
# Service-role key: bypasses Row Level Security entirely. Used only by
# automation/collector.js running inside GitHub Actions.
SUPABASE_SERVICE_ROLE_KEY=

# If/when you add a managed auth provider for the admin app (see README §5),
# its secrets go here too, e.g.:
# CLERK_SECRET_KEY=
# AUTH0_CLIENT_SECRET=
